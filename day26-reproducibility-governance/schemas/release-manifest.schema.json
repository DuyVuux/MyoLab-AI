{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semg-clinical-intelligence.local/schemas/release-manifest.schema.json",
  "title": "sEMG Clinical Intelligence Release Manifest",
  "x-governance": {
    "schema_version": "1.0",
    "status": "PROVISIONAL_LOCKED_FOR_DAY26_BLUEPRINT",
    "rationale": "Defines immutable release composition, compatibility, operational, license and rollback gates.",
    "evidence_ids": [
      "D26-INT-PROTOCOL",
      "EXT-NIST-AIRMF",
      "EXT-SKLEARN-PERSISTENCE"
    ],
    "open_questions": [
      "Final pilot target hardware",
      "Release signing infrastructure"
    ],
    "training_allowed": false
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "rationale",
    "evidence_ids",
    "open_questions",
    "training_allowed",
    "manifest_type",
    "release_id",
    "release_version",
    "release_state",
    "created_at",
    "target_environment",
    "deployment_mode",
    "components",
    "registry_records",
    "compatibility_gate",
    "license_gate",
    "security_gate",
    "operational_profile",
    "human_review",
    "rollback_target_release_id",
    "approvals",
    "audit_log_refs"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "training_allowed": {
      "type": "boolean"
    },
    "manifest_type": {
      "const": "release"
    },
    "release_id": {
      "type": "string",
      "pattern": "^REL-[0-9]{8}-[A-Z0-9-]+-[0-9]{3}$"
    },
    "release_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "release_state": {
      "enum": [
        "draft",
        "approved",
        "deployed",
        "suspended",
        "rolled-back",
        "retired"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "target_environment": {
      "enum": [
        "local-research",
        "on-prem-engineering",
        "pilot-silent",
        "pilot-controlled"
      ]
    },
    "deployment_mode": {
      "enum": [
        "offline-batch",
        "near-real-time-engineering",
        "pilot-controlled"
      ]
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact_ref"
      }
    },
    "registry_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "registry_id",
          "version",
          "record_sha256",
          "role"
        ],
        "properties": {
          "registry_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "record_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "compatibility_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "device",
        "export_schema",
        "protocol",
        "channel_mapping",
        "class_ontology",
        "runtime",
        "mfcv"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "PASS_WITH_CONDITIONS",
            "FAIL",
            "NOT_VERIFIED"
          ]
        },
        "device": {
          "type": "string",
          "minLength": 1
        },
        "export_schema": {
          "type": "string",
          "minLength": 1
        },
        "protocol": {
          "type": "string",
          "minLength": 1
        },
        "channel_mapping": {
          "type": "string",
          "minLength": 1
        },
        "class_ontology": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "mfcv": {
          "enum": [
            "not-used",
            "eligible-site-verified",
            "not-eligible",
            "not-verified"
          ]
        },
        "blocking_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "license_gate": {
      "$ref": "#/$defs/license_gate"
    },
    "security_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "hashes_verified",
        "untrusted_deserialization_present",
        "sbom_status"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "PASS_WITH_CONDITIONS",
            "FAIL",
            "NOT_RUN"
          ]
        },
        "hashes_verified": {
          "type": "boolean"
        },
        "untrusted_deserialization_present": {
          "type": "boolean"
        },
        "sbom_status": {
          "enum": [
            "NOT_CREATED_BLUEPRINT",
            "CREATED",
            "VERIFIED"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "operational_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compute_device",
        "gpu_required",
        "runtime_profile",
        "latency_budget_status",
        "memory_budget_status"
      ],
      "properties": {
        "compute_device": {
          "enum": [
            "cpu",
            "gpu",
            "cpu-with-optional-gpu"
          ]
        },
        "gpu_required": {
          "type": "boolean"
        },
        "runtime_profile": {
          "type": "string",
          "minLength": 1
        },
        "latency_budget_status": {
          "enum": [
            "NOT_VERIFIED",
            "MEASURED_ENGINEERING",
            "SITE_CONFIRMED"
          ]
        },
        "max_p95_end_to_end_latency_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "memory_budget_status": {
          "enum": [
            "NOT_VERIFIED",
            "MEASURED_ENGINEERING",
            "SITE_CONFIRMED"
          ]
        },
        "max_peak_rss_mb": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "human_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "workflow_id",
        "automatic_treatment_recommendation"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "workflow_id": {
          "type": "string",
          "minLength": 1
        },
        "automatic_treatment_recommendation": {
          "type": "boolean"
        }
      }
    },
    "rollback_target_release_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "approvals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/review_decision"
      }
    },
    "audit_log_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "release_state": {
            "enum": [
              "approved",
              "deployed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "components": {
            "minItems": 1
          },
          "registry_records": {
            "minItems": 1
          },
          "human_review": {
            "properties": {
              "required": {
                "const": true
              },
              "automatic_treatment_recommendation": {
                "const": false
              }
            }
          },
          "security_gate": {
            "properties": {
              "untrusted_deserialization_present": {
                "const": false
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "config_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config_id",
        "version",
        "uri",
        "sha256"
      ],
      "properties": {
        "config_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "role",
        "uri",
        "media_type",
        "sha256",
        "size_bytes",
        "trust_class"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "dataset_manifest",
            "raw_registry",
            "split_manifest",
            "test_seal",
            "preprocessing_config",
            "feature_config",
            "model_config",
            "calibration_config",
            "threshold_policy",
            "abstention_policy",
            "environment_lock",
            "model_bundle",
            "model_card",
            "evaluation_report",
            "prediction_ledger",
            "failure_cases",
            "release_manifest",
            "rollback_record",
            "code_archive",
            "hash_ledger",
            "sbom",
            "other"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "trust_class": {
          "enum": [
            "canonical-typed",
            "converted-runtime",
            "trusted-python-snapshot",
            "reference-only"
          ]
        }
      }
    },
    "review_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_role",
        "reviewer_id",
        "decision",
        "decided_at",
        "reasons"
      ],
      "properties": {
        "reviewer_role": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_id": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": [
            "pending",
            "approved",
            "approved-with-conditions",
            "rejected"
          ]
        },
        "decided_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "license_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "license_id",
        "access_class",
        "training_use",
        "research_use",
        "commercial_use",
        "redistribution",
        "trained_artifact_distribution",
        "attribution_required",
        "dua_or_irb_required",
        "review_status"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "license_id": {
          "type": "string",
          "minLength": 1
        },
        "license_uri_or_dua_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "access_class": {
          "enum": [
            "open",
            "registration",
            "dua",
            "restricted",
            "internal",
            "not-verified"
          ]
        },
        "training_use": {
          "enum": [
            "allowed",
            "not-allowed",
            "not-verified",
            "not-applicable"
          ]
        },
        "research_use": {
          "enum": [
            "allowed",
            "not-allowed",
            "not-verified",
            "not-applicable"
          ]
        },
        "commercial_use": {
          "enum": [
            "allowed",
            "not-allowed",
            "not-verified",
            "not-applicable"
          ]
        },
        "redistribution": {
          "enum": [
            "allowed",
            "not-allowed",
            "not-verified",
            "not-applicable"
          ]
        },
        "trained_artifact_distribution": {
          "enum": [
            "allowed",
            "not-allowed",
            "not-verified",
            "not-applicable"
          ]
        },
        "attribution_required": {
          "type": "boolean"
        },
        "share_alike_required": {
          "type": "boolean",
          "default": false
        },
        "dua_or_irb_required": {
          "type": "boolean"
        },
        "review_status": {
          "enum": [
            "reviewed",
            "pending",
            "not-verified"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "license_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregate_decision",
        "sources",
        "blocking_reasons"
      ],
      "properties": {
        "aggregate_decision": {
          "enum": [
            "pass-research",
            "pass-internal-engineering",
            "pass-pilot-noncommercial",
            "pass-pilot-approved",
            "block",
            "not-verified"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/license_source"
          }
        },
        "blocking_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
