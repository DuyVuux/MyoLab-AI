{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motionlab.local/schemas/quality-reason-codes.schema.json",
  "title": "MotionLab Quality Reason Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reason_code",
    "scope",
    "target_ref",
    "signal_quality",
    "semantic_class",
    "evidence_status",
    "evidence_refs",
    "config_version",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "reason_code": {
      "type": "string",
      "enum": [
        "MISSING_DROPOUT",
        "CLIPPING_SATURATION_SUSPECTED",
        "BASELINE_NOISE_ELEVATED",
        "POWERLINE_INTERFERENCE_SUSPECTED",
        "LOW_FREQUENCY_CONTAMINATION_SUSPECTED",
        "POOR_CONTACT_SUSPECTED",
        "CHANNEL_ABNORMALITY_UNRESOLVED",
        "PHYSIOLOGICAL_VARIATION_POSSIBLE",
        "ARTIFACT_VS_PHYSIOLOGY_UNRESOLVED",
        "CHANNEL_WARNING",
        "QUALITY_BLOCKED",
        "CLINICIAN_REVIEW_REQUIRED"
      ]
    },
    "scope": {
      "type": "string",
      "enum": [
        "SESSION",
        "CHANNEL",
        "WINDOW"
      ]
    },
    "target_ref": {
      "type": "string",
      "minLength": 1
    },
    "signal_quality": {
      "type": "string",
      "enum": [
        "PASS",
        "WARNING",
        "FAIL"
      ]
    },
    "semantic_class": {
      "type": "string",
      "enum": [
        "DATA_INTEGRITY",
        "ACQUISITION_ARTIFACT_SUSPECTED",
        "PHYSIOLOGICAL_VARIATION_POSSIBLE",
        "AMBIGUOUS_ARTIFACT_VS_PHYSIOLOGY",
        "REVIEW_OR_DISPOSITION"
      ]
    },
    "evidence_status": {
      "type": "string",
      "enum": [
        "VERIFIED_DOCUMENTED",
        "OBSERVED_SAMPLE_DATA",
        "SITE_VERIFIED",
        "INFERRED",
        "ASSUMPTION",
        "UNKNOWN",
        "TBD",
        "NOT_VERIFIED",
        "DISCOVERY_REQUIRED",
        "CONFLICTING"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "detector_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "detector_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "config_version": {
      "type": "string",
      "minLength": 1
    },
    "threshold_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "threshold_status": {
      "type": "string",
      "enum": [
        "SITE_VERIFIED",
        "TBD",
        "NOT_VERIFIED",
        "NOT_APPLICABLE",
        "POLICY_DEPENDENT"
      ]
    },
    "technical_action": {
      "type": [
        "string",
        "null"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
