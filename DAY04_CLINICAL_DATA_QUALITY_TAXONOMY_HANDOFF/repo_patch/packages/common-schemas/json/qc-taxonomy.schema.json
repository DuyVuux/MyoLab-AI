{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motionlab.local/schemas/qc-taxonomy.schema.json",
  "title": "MotionLab QC Taxonomy",
  "type": "object",
  "required": [
    "version",
    "day",
    "status",
    "principles",
    "reason_codes",
    "threshold_policy"
  ],
  "properties": {
    "version": {
      "const": "0.1"
    },
    "day": {
      "const": "DAY04"
    },
    "status": {
      "type": "string"
    },
    "principles": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string"
      }
    },
    "reason_codes": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": [
          "code",
          "semantic_class",
          "requirement",
          "definition",
          "quality_effect",
          "allowed_scopes",
          "evidence_required",
          "forbidden_inference",
          "threshold_status"
        ]
      }
    },
    "threshold_policy": {
      "type": "object",
      "required": [
        "numeric_thresholds_frozen",
        "status",
        "reason"
      ]
    }
  }
}
