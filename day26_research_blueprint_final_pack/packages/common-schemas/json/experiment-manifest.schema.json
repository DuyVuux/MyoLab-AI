{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExperimentManifest",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "trainingAllowed",
    "experiment_id",
    "task_id",
    "data",
    "split",
    "configs",
    "seeds",
    "environment",
    "metrics",
    "review"
  ],
  "properties": {
    "trainingAllowed": {
      "type": "boolean"
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^EXP-[0-9]{8}-TASK[ABC]-[A-Z0-9-]+-[0-9]{3}$"
    },
    "task_id": {
      "enum": [
        "TaskA",
        "TaskB",
        "TaskC"
      ]
    },
    "metrics": {
      "type": "object"
    }
  },
  "additionalProperties": true
}