{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "session-analysis-summary.schema.json",
  "title": "Session Analysis Summary v0.1",
  "type": "object",
  "required": ["schema_version", "analysis_id", "session_id", "status", "technical_conclusion", "signal_quality", "channels", "confidence", "explainability", "provenance", "safety", "limitations", "links", "summary_hash_sha256"],
  "properties": {
    "schema_version": {"const": "session-analysis-summary.v0.1"},
    "analysis_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["completed", "completed_with_warnings", "abstained", "blocked_by_wording_guard"]},
    "technical_conclusion": {"enum": ["supported_pattern", "no_supported_pattern", "inconclusive", "abstained"]},
    "signal_quality": {
      "type": "object",
      "required": ["status", "analysis_allowed", "reason_codes", "mfcv_eligible", "mfcv_reason_codes"],
      "properties": {
        "status": {"enum": ["pass", "warning", "fail", "import_rejected"]},
        "analysis_allowed": {"type": "boolean"},
        "reason_codes": {"type": "array", "items": {"type": "string"}},
        "mfcv_eligible": {"type": "boolean"},
        "mfcv_reason_codes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["channel_id", "muscle", "side", "role", "phase_id", "trends", "evidence_pattern", "technical_conclusion"],
        "properties": {
          "channel_id": {"type": "string"}, "muscle": {"type": "string"}, "side": {"type": "string"}, "role": {"type": "string"}, "phase_id": {"type": "string"},
          "trends": {"type": "array", "items": {"type": "object", "required": ["feature_name", "source_profile_id", "slope_per_min", "slope_unit", "percent_change", "r_squared"]}},
          "evidence_pattern": {"type": ["string", "null"]},
          "technical_conclusion": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "confidence": {
      "type": "object",
      "required": ["final_score_0_to_1", "category", "score_is_probability", "clinical_calibration_status"],
      "properties": {
        "final_score_0_to_1": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "category": {"enum": ["engineering_high", "engineering_moderate", "engineering_low", "engineering_very_low", "not_available"]},
        "score_is_probability": {"const": false},
        "clinical_calibration_status": {"const": "not_calibrated"}
      },
      "additionalProperties": false
    },
    "explainability": {"type": "object", "required": ["summary_vi", "decision_basis", "counterevidence", "wording_guard_status"]},
    "provenance": {
      "type": "object",
      "required": ["analysis_fingerprint_sha256", "source_hash_sha256", "pipeline_config_id", "config_hashes"],
      "properties": {
        "analysis_fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_hash_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pipeline_config_id": {"type": "string"},
        "config_hashes": {"type": "object", "additionalProperties": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "safety": {
      "type": "object",
      "required": ["clinical_use_allowed", "human_review_required", "is_diagnosis", "is_treatment_recommendation", "is_return_to_play_decision", "synthetic_data_is_clinical_evidence"],
      "properties": {
        "clinical_use_allowed": {"const": false},
        "human_review_required": {"const": true},
        "is_diagnosis": {"const": false},
        "is_treatment_recommendation": {"const": false},
        "is_return_to_play_decision": {"const": false},
        "synthetic_data_is_clinical_evidence": {"const": false}
      },
      "additionalProperties": false
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "links": {"type": "object", "required": ["self", "analysis", "manifest"], "additionalProperties": {"type": "string"}},
    "summary_hash_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "abstained"}}},
      "then": {
        "properties": {
          "technical_conclusion": {"const": "abstained"},
          "confidence": {"properties": {"final_score_0_to_1": {"type": "null"}, "category": {"const": "not_available"}}}
        }
      }
    }
  ]
}
