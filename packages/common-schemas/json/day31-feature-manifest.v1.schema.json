{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myolab.local/schemas/day31-feature-manifest.v1.schema.json",
  "title": "Day 31 reproducibility manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "run_type",
    "created_at_utc",
    "git_commit",
    "input_window_index_sha256",
    "feature_contract_sha256",
    "source_manifest_sha256",
    "preprocessing_policy_id",
    "channel_policy_ids",
    "dataset_views",
    "window_ms",
    "hop_ms",
    "sampling_mode",
    "feature_arms",
    "feature_rows",
    "failure_count",
    "output_hashes",
    "real_data_signal_rows_read",
    "test_signal_rows_read",
    "training_executed",
    "model_fitting_executed",
    "pooled_training_executed",
    "pass"
  ],
  "properties": {
    "schema_version": {"const": "day31-feature-manifest.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "run_type": {"enum": ["portable_synthetic_validation", "zone2_feature_extraction"]},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "input_window_index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "feature_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_manifest_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "preprocessing_policy_id": {"type": "string", "minLength": 1},
    "channel_policy_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "dataset_views": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "window_ms": {"type": "integer", "minimum": 1},
    "hop_ms": {"type": "integer", "minimum": 1},
    "sampling_mode": {"type": "string", "minLength": 1},
    "feature_arms": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "feature_rows": {"type": "integer", "minimum": 0},
    "failure_count": {"type": "integer", "minimum": 0},
    "output_hashes": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "real_data_signal_rows_read": {"type": "integer", "minimum": 0},
    "test_signal_rows_read": {"const": 0},
    "training_executed": {"const": false},
    "model_fitting_executed": {"const": false},
    "pooled_training_executed": {"const": false},
    "pass": {"type": "boolean"}
  }
}
