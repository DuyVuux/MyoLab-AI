{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/normalized-signal-summary.v0.1.json",
  "title": "Normalized Signal Summary v0.1",
  "description": "JSON-safe metadata/provenance summary. Raw signal arrays are intentionally excluded.",
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "data_source",
    "sampling_rate_hz",
    "sample_count",
    "channel_count",
    "elapsed_duration_s",
    "record_span_s",
    "protocol_ref",
    "phase_markers",
    "channels",
    "source_file_name",
    "source_hash_sha256",
    "processing_history"
  ],
  "properties": {
    "schema_version": {"const": "normalized-signal.v0.1"},
    "session_id": {"type": "string", "minLength": 1},
    "data_source": {"type": "string", "minLength": 1},
    "sampling_rate_hz": {"type": "number", "exclusiveMinimum": 0},
    "sample_count": {"type": "integer", "minimum": 2},
    "channel_count": {"type": "integer", "minimum": 1},
    "elapsed_duration_s": {"type": "number", "minimum": 0},
    "record_span_s": {"type": "number", "exclusiveMinimum": 0},
    "protocol_ref": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "phase_markers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["phase_id", "start_s", "end_s", "duration_s"],
        "properties": {
          "phase_id": {"type": "string", "minLength": 1},
          "start_s": {"type": "number", "minimum": 0},
          "end_s": {"type": "number", "exclusiveMinimum": 0},
          "duration_s": {"type": "number", "exclusiveMinimum": 0}
        },
        "additionalProperties": false
      }
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "channel_id",
          "muscle",
          "side",
          "role",
          "source_column",
          "source_unit",
          "canonical_unit",
          "sample_count",
          "finite_ratio"
        ],
        "properties": {
          "channel_id": {"type": "string", "minLength": 1},
          "muscle": {"type": "string", "minLength": 1},
          "side": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "source_column": {"type": "string", "minLength": 1},
          "source_unit": {"enum": ["uV", "mV", "V"]},
          "canonical_unit": {"const": "uV"},
          "sample_count": {"type": "integer", "minimum": 2},
          "finite_ratio": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    },
    "source_file_name": {"type": "string", "minLength": 1},
    "source_hash_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "processing_history": {"type": "object"}
  },
  "additionalProperties": false
}
