{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semg.local/schemas/time-domain-feature-extraction-result.v0.1.schema.json",
  "title": "Time-domain Feature Extraction Result v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "status",
    "downstream_allowed",
    "config",
    "inherited_windowing",
    "summary",
    "reason_codes",
    "result_hash_sha256",
    "rows",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "time-domain-feature-extraction-result.v0.1"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "completed",
        "completed_with_exclusions",
        "blocked"
      ]
    },
    "downstream_allowed": {
      "type": "boolean"
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config_id",
        "feature_names",
        "profile_id",
        "canonical_amplitude_unit",
        "normalization"
      ],
      "properties": {
        "config_id": {
          "const": "features_semg_v0.1"
        },
        "feature_names": {
          "type": "array",
          "prefixItems": [
            {
              "const": "rms"
            },
            {
              "const": "mav"
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "profile_id": {
          "const": "time_domain"
        },
        "canonical_amplitude_unit": {
          "const": "uV"
        },
        "normalization": {
          "const": "none"
        }
      }
    },
    "inherited_windowing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "config_id",
        "plan_hash_sha256"
      ],
      "properties": {
        "status": {
          "enum": [
            "completed",
            "blocked"
          ]
        },
        "config_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "plan_hash_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          ]
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_count",
        "total_row_count",
        "computed_row_count",
        "not_computed_row_count",
        "usable_window_ratio",
        "not_computed_reason_counts"
      ],
      "properties": {
        "channel_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_row_count": {
          "type": "integer",
          "minimum": 0
        },
        "computed_row_count": {
          "type": "integer",
          "minimum": 0
        },
        "not_computed_row_count": {
          "type": "integer",
          "minimum": 0
        },
        "usable_window_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "not_computed_reason_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "result_hash_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/featureRow"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "properties": {
          "downstream_allowed": {
            "const": false
          },
          "result_hash_sha256": {
            "type": "null"
          },
          "rows": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "completed",
              "completed_with_exclusions"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "downstream_allowed": {
            "const": true
          },
          "result_hash_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "rows": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "amplitudeFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "const": "uV"
        }
      }
    },
    "featureRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "feature_row_id",
        "session_id",
        "channel",
        "phase_id",
        "profile_id",
        "window",
        "status",
        "features",
        "reason_codes",
        "provenance"
      ],
      "properties": {
        "schema_version": {
          "const": "feature-row.v0.1"
        },
        "feature_row_id": {
          "type": "string",
          "pattern": "^FR-[0-9a-f]{24}$"
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "channel_id",
            "muscle",
            "side",
            "role"
          ],
          "properties": {
            "channel_id": {
              "type": "string",
              "minLength": 1
            },
            "muscle": {
              "type": "string",
              "minLength": 1
            },
            "side": {
              "type": "string",
              "minLength": 1
            },
            "role": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "phase_id": {
          "const": "active_contraction"
        },
        "profile_id": {
          "const": "time_domain"
        },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "window_id",
            "window_index",
            "start_sample",
            "end_sample_exclusive",
            "start_time_s",
            "end_time_exclusive_s",
            "center_time_s",
            "sample_count"
          ],
          "properties": {
            "window_id": {
              "type": "string",
              "pattern": "^W[0-9]{4,}$"
            },
            "window_index": {
              "type": "integer",
              "minimum": 0
            },
            "start_sample": {
              "type": "integer",
              "minimum": 0
            },
            "end_sample_exclusive": {
              "type": "integer",
              "minimum": 1
            },
            "start_time_s": {
              "type": "number",
              "minimum": 0
            },
            "end_time_exclusive_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "center_time_s": {
              "type": "number",
              "minimum": 0
            },
            "sample_count": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "status": {
          "enum": [
            "computed",
            "not_computed"
          ]
        },
        "features": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rms",
                "mav",
                "sample_count"
              ],
              "properties": {
                "rms": {
                  "$ref": "#/$defs/amplitudeFeature"
                },
                "mav": {
                  "$ref": "#/$defs/amplitudeFeature"
                },
                "sample_count": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          ]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "feature_extractor_id",
            "windowing_config_id",
            "preprocess_config_id",
            "source_signal_hash_sha256",
            "window_plan_hash_sha256"
          ],
          "properties": {
            "feature_extractor_id": {
              "const": "features_semg_v0.1"
            },
            "windowing_config_id": {
              "const": "windowing_v0.1"
            },
            "preprocess_config_id": {
              "const": "preprocess_v0.1"
            },
            "source_signal_hash_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "window_plan_hash_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "computed"
              }
            }
          },
          "then": {
            "properties": {
              "features": {
                "type": "object"
              },
              "reason_codes": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_computed"
              }
            }
          },
          "then": {
            "properties": {
              "features": {
                "type": "null"
              },
              "reason_codes": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
