{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myolab.local/schemas/day31-feature-row.v1.schema.json",
  "title": "Day 31 canonical long feature row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_id",
    "dataset_view_id",
    "split_name",
    "subject_id",
    "day_id",
    "session_id",
    "repetition_id",
    "record_id",
    "window_id",
    "channel_id",
    "canonical_label",
    "sampling_rate_hz",
    "window_ms",
    "hop_ms",
    "preprocessing_policy_id",
    "channel_policy_id",
    "source_file_sha256",
    "split_version",
    "label_mapping_version",
    "feature_id",
    "feature_value",
    "feature_version",
    "qc_flags"
  ],
  "properties": {
    "dataset_id": {"type": "string", "minLength": 1},
    "dataset_view_id": {"type": "string", "minLength": 1},
    "split_name": {"enum": ["train", "validation"]},
    "subject_id": {"type": "string", "minLength": 1},
    "day_id": {"type": ["string", "null"]},
    "session_id": {"type": ["string", "null"]},
    "repetition_id": {"type": ["string", "null"]},
    "record_id": {"type": "string", "minLength": 1},
    "window_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
    "channel_id": {"type": "string", "minLength": 1},
    "canonical_label": {"type": "string", "minLength": 1},
    "sampling_rate_hz": {"type": "number", "exclusiveMinimum": 0},
    "window_ms": {"type": "integer", "minimum": 1},
    "hop_ms": {"type": "integer", "minimum": 1},
    "preprocessing_policy_id": {"type": "string", "minLength": 1},
    "channel_policy_id": {"type": "string", "minLength": 1},
    "source_file_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "split_version": {"type": "string", "minLength": 1},
    "label_mapping_version": {"type": "string", "minLength": 1},
    "feature_id": {
      "enum": [
        "rms",
        "mav",
        "skewness_unbiased",
        "kurtosis_fisher_unbiased",
        "max_signed",
        "min_signed",
        "std_sample_ddof1",
        "mean",
        "spectral_min_power",
        "spectral_max_power",
        "spectral_std_power_ddof1",
        "mdf_hz",
        "mnf_hz",
        "spectral_entropy_bits"
      ]
    },
    "feature_value": {"type": ["number", "null"]},
    "feature_version": {"const": "feature-set-14.v1.0.0"},
    "qc_flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "nonfinite_input",
          "insufficient_samples_moments",
          "constant_window",
          "zero_power_window",
          "insufficient_spectral_bins",
          "numeric_overflow",
          "feature_nonfinite",
          "channel_quarantined",
          "source_partition_forbidden",
          "source_path_forbidden",
          "source_integrity_mismatch"
        ]
      }
    }
  }
}
