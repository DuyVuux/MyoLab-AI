{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "site-export-inspection.v0.1.schema.json",
  "title": "Site Export Inspection Report",
  "description": "Schema cho output của inspect_unknown_export.py — inventory của file export chưa biết cấu trúc.",
  "type": "object",
  "required": ["inspectionVersion", "inspectedAt", "inputPath", "fileTree"],
  "properties": {
    "inspectionVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "inspectedAt": {
      "type": "string",
      "format": "date-time"
    },
    "inputPath": {
      "type": "string"
    },
    "inputHashSha256": {
      "type": ["string", "null"]
    },
    "fileTree": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["relativePath", "sizeBytes", "extension"],
        "properties": {
          "relativePath": { "type": "string" },
          "sizeBytes": { "type": "integer" },
          "extension": { "type": "string" },
          "mimeType": { "type": ["string", "null"] }
        }
      }
    },
    "extensions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "fileSizes": {
      "type": "object",
      "additionalProperties": { "type": "integer" }
    },
    "encodingCandidates": {
      "type": "array",
      "items": { "type": "string" }
    },
    "delimiterCandidates": {
      "type": "array",
      "items": { "type": "string" }
    },
    "csvHeaders": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": { "type": "string" },
          "headers": { "type": "array", "items": { "type": "string" } },
          "rowCount": { "type": "integer" },
          "columnCount": { "type": "integer" }
        }
      }
    },
    "sheetNames": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": { "type": "string" },
          "sheets": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "matVariables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": { "type": "string" },
          "variables": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "c3dAnalogChannels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": { "type": "string" },
          "channels": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "candidateTimeColumns": {
      "type": "array",
      "items": { "type": "string" }
    },
    "candidateSignalColumns": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
