{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semg.local/schemas/time-domain-feature-verification.v0.1.schema.json",
  "title": "Time-domain Feature Verification v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verification_status",
    "feature_extractor_id",
    "scope",
    "cases",
    "properties",
    "environment",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "time-domain-feature-verification.v0.1"},
    "verification_status": {"enum": ["passed", "failed"]},
    "feature_extractor_id": {"const": "features_semg_v0.1"},
    "scope": {"const": "software_dsp_analytical_verification_only"},
    "cases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "observed", "expected", "relative_error", "tolerance", "passed"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "observed": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rms", "mav"],
            "properties": {
              "rms": {"type": "number", "minimum": 0},
              "mav": {"type": "number", "minimum": 0}
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rms", "mav"],
            "properties": {
              "rms": {"type": "number", "minimum": 0},
              "mav": {"type": "number", "minimum": 0}
            }
          },
          "relative_error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rms", "mav"],
            "properties": {
              "rms": {"type": "number", "minimum": 0},
              "mav": {"type": "number", "minimum": 0}
            }
          },
          "tolerance": {"type": "number", "minimum": 0},
          "passed": {"type": "boolean"}
        }
      }
    },
    "properties": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["case_id", "passed"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"}
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "numpy", "platform"],
      "properties": {
        "python": {"type": "string", "minLength": 1},
        "numpy": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
