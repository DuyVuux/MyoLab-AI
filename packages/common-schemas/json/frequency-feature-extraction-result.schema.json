{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semg-fatigue.local/schemas/frequency-feature-extraction-result.schema.json",
  "title": "Frequency Feature Extraction Result v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "status",
    "downstream_allowed",
    "config",
    "inherited_spectral",
    "analysis_band",
    "summary",
    "reason_codes",
    "result_hash_sha256",
    "rows",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "frequency-feature-extraction-result.v0.1"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "completed",
        "completed_with_exclusions",
        "blocked"
      ]
    },
    "downstream_allowed": {
      "type": "boolean"
    },
    "config": {
      "type": "object",
      "required": [
        "config_id",
        "feature_names",
        "profile_id",
        "frequency_unit",
        "psd_unit",
        "clinical_validation_status"
      ],
      "properties": {
        "config_id": {
          "const": "frequency_features_v0.1"
        },
        "feature_names": {
          "const": [
            "mdf",
            "mnf"
          ]
        },
        "profile_id": {
          "const": "frequency_domain"
        },
        "frequency_unit": {
          "const": "Hz"
        },
        "psd_unit": {
          "const": "uV^2/Hz"
        },
        "clinical_validation_status": {
          "const": "not_validated"
        }
      }
    },
    "inherited_spectral": {
      "type": "object"
    },
    "analysis_band": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object"
        }
      ]
    },
    "summary": {
      "type": "object",
      "required": [
        "channel_count",
        "total_row_count",
        "computed_row_count",
        "not_computed_row_count",
        "usable_window_ratio",
        "not_computed_reason_counts"
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "result_hash_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
