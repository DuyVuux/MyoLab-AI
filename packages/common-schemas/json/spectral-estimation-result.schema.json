{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semg-fatigue.local/schemas/spectral-estimation-result.schema.json",
  "title": "Spectral Estimation Result v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "status",
    "downstream_allowed",
    "config",
    "inherited_windowing",
    "frequency_axis",
    "estimator",
    "summary",
    "reason_codes",
    "result_hash_sha256",
    "rows",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "spectral-estimation-result.v0.1"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "completed",
        "completed_with_exclusions",
        "blocked"
      ]
    },
    "downstream_allowed": {
      "type": "boolean"
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config_id",
        "profile_id",
        "canonical_amplitude_unit",
        "psd_unit",
        "mdf_mnf_computed"
      ],
      "properties": {
        "config_id": {
          "const": "spectral_estimation_v0.1"
        },
        "profile_id": {
          "const": "frequency_domain"
        },
        "canonical_amplitude_unit": {
          "const": "uV"
        },
        "psd_unit": {
          "const": "uV^2/Hz"
        },
        "mdf_mnf_computed": {
          "const": false
        }
      }
    },
    "inherited_windowing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "config_id",
        "plan_hash_sha256"
      ],
      "properties": {
        "status": {
          "type": "string"
        },
        "config_id": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "plan_hash_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "frequency_axis": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "values",
            "unit",
            "bin_count",
            "lower_hz",
            "upper_hz",
            "bin_spacing_hz",
            "rayleigh_resolution_hz"
          ],
          "properties": {
            "values": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "number",
                "minimum": 0
              }
            },
            "unit": {
              "const": "Hz"
            },
            "bin_count": {
              "type": "integer",
              "minimum": 2
            },
            "lower_hz": {
              "type": "number",
              "minimum": 0
            },
            "upper_hz": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "bin_spacing_hz": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "rayleigh_resolution_hz": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      ]
    },
    "estimator": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "return_onesided",
            "taper",
            "detrend",
            "scaling",
            "average",
            "nperseg_samples",
            "noverlap_samples",
            "nfft_samples",
            "zero_padding_enabled",
            "frequency_bin_spacing_hz",
            "rayleigh_resolution_hz",
            "analysis_band_low_hz",
            "analysis_band_high_hz",
            "frequency_bin_count"
          ],
          "properties": {
            "method": {
              "const": "welch"
            },
            "return_onesided": {
              "const": true
            },
            "taper": {
              "const": "hann"
            },
            "detrend": {
              "const": "constant"
            },
            "scaling": {
              "const": "density"
            },
            "average": {
              "const": "mean"
            },
            "nperseg_samples": {
              "type": "integer",
              "minimum": 4
            },
            "noverlap_samples": {
              "type": "integer",
              "minimum": 0
            },
            "nfft_samples": {
              "type": "integer",
              "minimum": 4
            },
            "zero_padding_enabled": {
              "const": false
            },
            "frequency_bin_spacing_hz": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "rayleigh_resolution_hz": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "analysis_band_low_hz": {
              "type": "number",
              "minimum": 0
            },
            "analysis_band_high_hz": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "frequency_bin_count": {
              "type": "integer",
              "minimum": 2
            }
          }
        }
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_count",
        "total_row_count",
        "computed_row_count",
        "not_computed_row_count",
        "usable_window_ratio",
        "not_computed_reason_counts"
      ],
      "properties": {
        "channel_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_row_count": {
          "type": "integer",
          "minimum": 0
        },
        "computed_row_count": {
          "type": "integer",
          "minimum": 0
        },
        "not_computed_row_count": {
          "type": "integer",
          "minimum": 0
        },
        "usable_window_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "not_computed_reason_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "result_hash_sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "properties": {
          "downstream_allowed": {
            "const": false
          },
          "frequency_axis": {
            "type": "null"
          },
          "estimator": {
            "type": "null"
          },
          "result_hash_sha256": {
            "type": "null"
          },
          "rows": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "completed",
              "completed_with_exclusions"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "downstream_allowed": {
            "const": true
          },
          "frequency_axis": {
            "type": "object"
          },
          "estimator": {
            "type": "object"
          },
          "result_hash_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "rows": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
