{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myolab-ai.local/schemas/gesture-feedback-context.v0.1.schema.json",
  "title": "Exact Gesture Feedback Context v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "analysisId",
    "sessionId",
    "windowId",
    "rawSignalRef",
    "sourceHashSha256",
    "startSample",
    "endSampleExclusive",
    "startTimeS",
    "endTimeExclusiveS",
    "channelIds",
    "repetitionId",
    "calibrationId",
    "modelVersion",
    "originalResultHashSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": "gesture-feedback-context.v0.1"
    },
    "analysisId": {
      "$ref": "#/$defs/nonEmptyId"
    },
    "sessionId": {
      "$ref": "#/$defs/nonEmptyId"
    },
    "windowId": {
      "$ref": "#/$defs/nonEmptyId"
    },
    "rawSignalRef": {
      "$ref": "#/$defs/nonEmptyId"
    },
    "sourceHashSha256": {
      "$ref": "#/$defs/sha256"
    },
    "startSample": {
      "type": "integer",
      "minimum": 0
    },
    "endSampleExclusive": {
      "type": "integer",
      "minimum": 1
    },
    "startTimeS": {
      "type": "number",
      "minimum": 0
    },
    "endTimeExclusiveS": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "channelIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyId"
      }
    },
    "repetitionId": {
      "$ref": "#/$defs/nonEmptyId"
    },
    "calibrationId": {
      "$ref": "#/$defs/nonEmptyId"
    },
    "modelVersion": {
      "$ref": "#/$defs/nonEmptyId"
    },
    "originalResultHashSha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "nonEmptyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
