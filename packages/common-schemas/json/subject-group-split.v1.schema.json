    "schemaVersion",
    "datasetId",
    "groupUnit",
    "groups",
    "testSetSealed",
    "testOpened",
    "splitSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": "subject-group-split.v1"
    },
    "groupUnit": {
      "const": "subject"
    },
    "testSetSealed": {
      "const": true
    },
    "testOpened": {
      "const": false
    },
    "groups": {
      "type": "object",
      "required": [
        "train",
        "validation",
        "test"
      ]
    }
  },
  "additionalProperties": true
}
