{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gate-a-readiness.schema.json",
  "title": "MotionLab Gate A Readiness Evidence",
  "type": "object",
  "required": [
    "version",
    "gate_id",
    "day",
    "evaluation_mode",
    "criteria",
    "manual_review",
    "decision"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "gate_id": {
      "const": "GATE_A"
    },
    "day": {
      "const": "DAY_08"
    },
    "evaluation_mode": {
      "const": "EVIDENCE_GATED"
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "critical",
          "status",
          "evidence_refs",
          "why"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^GA-[0-9]{2}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "critical": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "VERIFIED_DOCUMENTED",
              "SITE_VERIFIED",
              "NOT_VERIFIED",
              "BLOCKED",
              "NOT_APPLICABLE"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "why": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "manual_review": {
      "type": "object",
      "required": [
        "status",
        "reviewer_id",
        "reviewed_at",
        "evidence_scope_reviewed",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "PENDING",
            "APPROVED",
            "REJECTED"
          ]
        },
        "reviewer_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_scope_reviewed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": [
        "gate_decision",
        "day_status",
        "reason"
      ],
      "properties": {
        "gate_decision": {
          "enum": [
            "REQUIREMENTS_READY",
            "BLOCKED_DISCOVERY"
          ]
        },
        "day_status": {
          "enum": [
            "GO_FOR_DAY_09",
            "READY_WITH_LIMITATIONS",
            "BLOCKED_WITH_EVIDENCE"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
