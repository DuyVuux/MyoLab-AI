{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myolab-ai.local/schemas/uc1-replay-session.v0.1.schema.json",
  "title": "UC1 Replay Session v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "replayId",
    "sessionId",
    "analysisId",
    "scenarioId",
    "state",
    "currentIndex",
    "revision",
    "totalWindows",
    "currentWindow",
    "history",
    "latencySummary",
    "reasonCodes",
    "sourceType",
    "modelValidationStatus",
    "clinicalUseAllowed",
    "humanReviewRequired"
  ],
  "properties": {
    "schemaVersion": {
      "const": "uc1-replay-session.v0.1"
    },
    "replayId": {
      "$ref": "#/$defs/nonEmptyId"
    },
    "sessionId": {
      "$ref": "#/$defs/nonEmptyId"
    },
    "analysisId": {
      "$ref": "#/$defs/nonEmptyId"
    },
    "scenarioId": {
      "enum": [
        "uc1_golden_correct",
        "uc1_ambiguous_prediction",
        "uc1_no_activity",
        "uc1_fatigue_confidence_drop",
        "uc1_electrode_shift_warning",
        "uc1_qc_fail_abstention",
        "uc1_device_disconnect"
      ]
    },
    "state": {
      "description": "For nonzero replays: idle iff currentIndex=-1; running is partial; completed, abstained, and disconnected are at the last window. Failed may preserve any revealed cursor.",
      "enum": [
        "idle",
        "running",
        "completed",
        "abstained",
        "disconnected",
        "failed"
      ]
    },
    "currentIndex": {
      "type": "integer",
      "minimum": -1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "totalWindows": {
      "type": "integer",
      "minimum": 0
    },
    "currentWindow": {
      "description": "Current revealed window; its windowId MUST NOT appear in history.",
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/gestureInferenceWindow"}
      ]
    },
    "history": {
      "description": "Chronological past-only windows; length equals max(0, currentIndex).",
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/gestureInferenceWindow"
      }
    },
    "latencySummary": {
      "$ref": "#/$defs/latencySummary"
    },
    "reasonCodes": {
      "$ref": "#/$defs/stringArray"
    },
    "sourceType": {
      "const": "synthetic_replay"
    },
    "modelValidationStatus": {
      "const": "not_validated"
    },
    "clinicalUseAllowed": {
      "const": false
    },
    "humanReviewRequired": {
      "const": true
    }
  },
  "$defs": {
    "nonEmptyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "activeGesture": {
      "enum": [
        "hand_open",
        "hand_close",
        "wrist_flexion",
        "wrist_extension"
      ]
    },
    "confidence": {
      "enum": [
        "engineering_high",
        "engineering_moderate",
        "engineering_low",
        "engineering_very_low",
        "not_available"
      ]
    },
    "confidenceMonotonic": {
      "allOf": [
        {
          "if": {
            "properties": {
              "baseEngineeringConfidence": {"const": "not_available"}
            },
            "required": ["baseEngineeringConfidence"]
          },
          "then": {
            "properties": {
              "engineeringConfidence": {"const": "not_available"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "baseEngineeringConfidence": {
                "const": "engineering_very_low"
              }
            },
            "required": ["baseEngineeringConfidence"]
          },
          "then": {
            "properties": {
              "engineeringConfidence": {
                "enum": ["not_available", "engineering_very_low"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "baseEngineeringConfidence": {"const": "engineering_low"}
            },
            "required": ["baseEngineeringConfidence"]
          },
          "then": {
            "properties": {
              "engineeringConfidence": {
                "enum": [
                  "not_available",
                  "engineering_very_low",
                  "engineering_low"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "baseEngineeringConfidence": {
                "const": "engineering_moderate"
              }
            },
            "required": ["baseEngineeringConfidence"]
          },
          "then": {
            "properties": {
              "engineeringConfidence": {
                "enum": [
                  "not_available",
                  "engineering_very_low",
                  "engineering_low",
                  "engineering_moderate"
                ]
              }
            }
          }
        }
      ]
    },
    "stringArray": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "segmentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rawSignalRef",
        "sourceHashSha256",
        "startSample",
        "endSampleExclusive",
        "startTimeS",
        "endTimeExclusiveS",
        "channelIds",
        "repetitionId",
        "calibrationId"
      ],
      "properties": {
        "rawSignalRef": {"$ref": "#/$defs/nonEmptyId"},
        "sourceHashSha256": {"$ref": "#/$defs/sha256"},
        "startSample": {"type": "integer", "minimum": 0},
        "endSampleExclusive": {"type": "integer", "minimum": 1},
        "startTimeS": {"type": "number", "minimum": 0},
        "endTimeExclusiveS": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "channelIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyId"}
        },
        "repetitionId": {"$ref": "#/$defs/nonEmptyId"},
        "calibrationId": {"$ref": "#/$defs/nonEmptyId"}
      }
    },
    "activityGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "windowRmsUv",
        "activationThresholdUv",
        "releaseThresholdUv",
        "reasonCode"
      ],
      "properties": {
        "status": {"enum": ["active", "inactive", "uncertain"]},
        "windowRmsUv": {"type": "number", "minimum": 0},
        "activationThresholdUv": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "releaseThresholdUv": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reasonCode": {"$ref": "#/$defs/nonEmptyId"}
      }
    },
    "qualityContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "qualityResultId", "status", "reasonCodes"],
      "properties": {
        "source": {
          "enum": [
            "day20_quality_gate",
            "day17_signal_quality",
            "scenario_fixture",
            "not_available"
          ]
        },
        "qualityResultId": {"$ref": "#/$defs/nonEmptyId"},
        "status": {"enum": ["pass", "warning", "fail"]},
        "reasonCodes": {"$ref": "#/$defs/stringArray"}
      }
    },
    "fatigueOverlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "status",
        "confidenceAdjustmentApplied",
        "reasonCodes",
        "evidenceSummaryVi",
        "counterevidenceVi",
        "limitationsVi"
      ],
      "properties": {
        "source": {
          "enum": [
            "scenario_fixture",
            "analysis_summary",
            "not_available"
          ]
        },
        "status": {
          "enum": ["stable", "warning", "abstain", "not_available"]
        },
        "confidenceAdjustmentApplied": {"type": "boolean"},
        "reasonCodes": {"$ref": "#/$defs/stringArray"},
        "evidenceSummaryVi": {"$ref": "#/$defs/stringArray"},
        "counterevidenceVi": {"$ref": "#/$defs/stringArray"},
        "limitationsVi": {"$ref": "#/$defs/stringArray"}
      }
    },
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalMs",
        "acquisitionMs",
        "windowMs",
        "preprocessMs",
        "inferenceMs",
        "transportRenderMs"
      ],
      "properties": {
        "totalMs": {"type": "number", "minimum": 0},
        "acquisitionMs": {"type": "number", "minimum": 0},
        "windowMs": {"type": "number", "minimum": 0},
        "preprocessMs": {"type": "number", "minimum": 0},
        "inferenceMs": {"type": "number", "minimum": 0},
        "transportRenderMs": {"type": "number", "minimum": 0}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scoreIsProbability",
        "clinicalUseAllowed",
        "rawSamplesIncluded",
        "physicalActuationAllowed"
      ],
      "properties": {
        "scoreIsProbability": {"const": false},
        "clinicalUseAllowed": {"const": false},
        "rawSamplesIncluded": {"const": false},
        "physicalActuationAllowed": {"const": false}
      }
    },
    "gestureInferenceWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "windowId",
        "sessionId",
        "analysisId",
        "protocolVersion",
        "segmentRef",
        "targetGesture",
        "activityGate",
        "predictedGesture",
        "baseEngineeringConfidence",
        "engineeringConfidence",
        "qualityContext",
        "fatigueOverlay",
        "deviceState",
        "latency",
        "requiresHumanReview",
        "sourceType",
        "modelVersion",
        "modelValidationStatus",
        "resultHashSha256",
        "safety"
      ],
      "properties": {
        "schemaVersion": {"const": "gesture-inference.v0.1"},
        "windowId": {"$ref": "#/$defs/nonEmptyId"},
        "sessionId": {"$ref": "#/$defs/nonEmptyId"},
        "analysisId": {"$ref": "#/$defs/nonEmptyId"},
        "protocolVersion": {"$ref": "#/$defs/nonEmptyId"},
        "segmentRef": {"$ref": "#/$defs/segmentRef"},
        "targetGesture": {"$ref": "#/$defs/activeGesture"},
        "activityGate": {"$ref": "#/$defs/activityGate"},
        "predictedGesture": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/activeGesture"}
          ]
        },
        "baseEngineeringConfidence": {"$ref": "#/$defs/confidence"},
        "engineeringConfidence": {"$ref": "#/$defs/confidence"},
        "qualityContext": {"$ref": "#/$defs/qualityContext"},
        "fatigueOverlay": {"$ref": "#/$defs/fatigueOverlay"},
        "deviceState": {
          "enum": ["connected", "disconnected", "reconnecting"]
        },
        "latency": {"$ref": "#/$defs/latency"},
        "requiresHumanReview": {"const": true},
        "sourceType": {"const": "synthetic_replay"},
        "modelVersion": {"$ref": "#/$defs/nonEmptyId"},
        "modelValidationStatus": {"const": "not_validated"},
        "resultHashSha256": {"$ref": "#/$defs/sha256"},
        "safety": {"$ref": "#/$defs/safety"}
      },
      "allOf": [
        {"$ref": "#/$defs/confidenceMonotonic"},
        {
          "if": {
            "properties": {
              "fatigueOverlay": {
                "properties": {"source": {"const": "not_available"}},
                "required": ["source"]
              }
            },
            "required": ["fatigueOverlay"]
          },
          "then": {
            "properties": {
              "fatigueOverlay": {
                "properties": {"status": {"const": "not_available"}}
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "fatigueOverlay": {
                "properties": {"status": {"const": "not_available"}},
                "required": ["status"]
              }
            },
            "required": ["fatigueOverlay"]
          },
          "then": {
            "properties": {
              "fatigueOverlay": {
                "properties": {"source": {"const": "not_available"}}
              }
            }
          }
        }
      ]
    },
    "latencySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observedWindowCount",
        "p50Ms",
        "p95Ms",
        "droppedWindows",
        "disconnectTimeoutMs"
      ],
      "properties": {
        "observedWindowCount": {
          "type": "integer",
          "minimum": 0
        },
        "p50Ms": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "p95Ms": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "droppedWindows": {
          "type": "integer",
          "minimum": 0
        },
        "disconnectTimeoutMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
