{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motionlab.vsf.local/schemas/decision-record.schema.json",
  "title": "MotionLab Decision Ledger v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "day",
    "decisions"
  ],
  "properties": {
    "version": {
      "const": "0.1"
    },
    "day": {
      "const": "DAY01"
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision_id",
          "title",
          "date",
          "status",
          "context",
          "decision",
          "rationale",
          "source",
          "alternatives",
          "consequences",
          "affected_requirements",
          "supersedes",
          "superseded_by",
          "owner",
          "review_required"
        ],
        "properties": {
          "decision_id": {
            "type": "string",
            "pattern": "^D\\d{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "enum": [
              "PROPOSED",
              "ACCEPTED",
              "SUPERSEDED",
              "REJECTED"
            ]
          },
          "context": {
            "type": "string",
            "minLength": 5
          },
          "decision": {
            "type": "string",
            "minLength": 5
          },
          "rationale": {
            "type": "string",
            "minLength": 5
          },
          "source": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "consequences": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "affected_requirements": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "supersedes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "superseded_by": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "owner": {
            "type": "string",
            "minLength": 2
          },
          "review_required": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
