{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "day28-eda-summary.schema.json",
  "title": "Day 28 EDA Summary",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "training_execution_allowed",
    "test_set_sealed"
  ],
  "properties": {
    "schema_version": {
      "const": "day28-eda-summary.v1"
    },
    "status": {
      "enum": [
        "NOT_RUN_BLOCKED_EXTERNAL_DATA",
        "COMPLETED",
        "BLOCKED_WITH_EVIDENCE"
      ]
    },
    "training_execution_allowed": {
      "const": false
    },
    "test_set_sealed": {
      "type": "boolean"
    },
    "dataset_id": {
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
