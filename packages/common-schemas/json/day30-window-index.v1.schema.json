{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myolab.ai/schemas/day30-window-index.v1.schema.json",
  "title": "Day 30 window index row",
  "type": "object",
  "required": [
    "window_id",
    "dataset_id",
    "record_id",
    "subject_id",
    "day_id",
    "session_id",
    "repetition_id",
    "canonical_label",
    "partition",
    "signal_path",
    "source_file_sha256",
    "split_version",
    "label_mapping_version",
    "start_sample",
    "end_sample_exclusive",
    "record_n_samples",
    "sampling_rate_hz",
    "window_ms",
    "hop_ms",
    "channel_policy_id",
    "preprocessing_policy_id"
  ],
  "properties": {
    "window_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
    "dataset_id": {"type": "string", "minLength": 1},
    "record_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "day_id": {"type": "string"},
    "session_id": {"type": "string"},
    "repetition_id": {"type": "string"},
    "canonical_label": {
      "enum": [
        "rest",
        "hand_open",
        "hand_close",
        "wrist_flexion",
        "wrist_extension"
      ]
    },
    "partition": {"enum": ["train", "validation"]},
    "signal_path": {"type": "string", "minLength": 1},
    "source_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "split_version": {"type": "string", "minLength": 1},
    "label_mapping_version": {"type": "string", "minLength": 1},
    "start_sample": {"type": "integer", "minimum": 0},
    "end_sample_exclusive": {"type": "integer", "minimum": 1},
    "record_n_samples": {"type": "integer", "minimum": 1},
    "sampling_rate_hz": {"type": "number", "exclusiveMinimum": 0},
    "window_ms": {"type": "integer", "exclusiveMinimum": 0},
    "hop_ms": {"type": "integer", "exclusiveMinimum": 0},
    "channel_policy_id": {"type": "string", "minLength": 1},
    "preprocessing_policy_id": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
