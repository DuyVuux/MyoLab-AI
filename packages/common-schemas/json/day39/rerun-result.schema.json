{
  "$defs": {
    "RerunComparison": {
      "properties": {
        "metric_name": {
          "title": "Metric Name",
          "type": "string"
        },
        "absolute_delta": {
          "title": "Absolute Delta",
          "type": "number"
        },
        "within_tolerance": {
          "title": "Within Tolerance",
          "type": "boolean"
        },
        "tolerance_applied": {
          "title": "Tolerance Applied",
          "type": "number"
        }
      },
      "required": [
        "metric_name",
        "absolute_delta",
        "within_tolerance",
        "tolerance_applied"
      ],
      "title": "RerunComparison",
      "type": "object"
    },
    "RerunStatusEnum": {
      "enum": [
        "EXACT_MATCH",
        "MATCH_WITHIN_TOLERANCE",
        "MISMATCH",
        "NONCOMPARABLE",
        "BLOCKED"
      ],
      "title": "RerunStatusEnum",
      "type": "string"
    }
  },
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "original_run_id": {
      "title": "Original Run Id",
      "type": "string"
    },
    "rerun_id": {
      "title": "Rerun Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RerunStatusEnum"
    },
    "comparisons": {
      "items": {
        "$ref": "#/$defs/RerunComparison"
      },
      "title": "Comparisons",
      "type": "array"
    },
    "prediction_mismatch_count": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prediction Mismatch Count"
    }
  },
  "required": [
    "original_run_id",
    "rerun_id",
    "status",
    "comparisons"
  ],
  "title": "RerunResult",
  "type": "object"
}