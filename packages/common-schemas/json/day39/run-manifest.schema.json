{
  "$defs": {
    "RandomSeeds": {
      "properties": {
        "split_seed": {
          "title": "Split Seed",
          "type": "integer"
        },
        "model_seed": {
          "title": "Model Seed",
          "type": "integer"
        },
        "bootstrap_seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bootstrap Seed"
        },
        "calibration_seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calibration Seed"
        },
        "fewshot_seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fewshot Seed"
        },
        "domain_classifier_seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain Classifier Seed"
        }
      },
      "required": [
        "split_seed",
        "model_seed"
      ],
      "title": "RandomSeeds",
      "type": "object"
    },
    "RegistryStateEnum": {
      "enum": [
        "DRAFT",
        "AUTHORIZED",
        "RUNNING",
        "COMPLETED",
        "COMPLETED_WITH_WARNINGS",
        "FAILED",
        "REJECTED",
        "ARCHIVED"
      ],
      "title": "RegistryStateEnum",
      "type": "string"
    }
  },
  "properties": {
    "run_id": {
      "description": "Unique identifier for the run",
      "title": "Run Id",
      "type": "string"
    },
    "created_at_utc": {
      "description": "ISO 8601 UTC timestamp",
      "title": "Created At Utc",
      "type": "string"
    },
    "git_commit": {
      "description": "Git commit hash",
      "title": "Git Commit",
      "type": "string"
    },
    "environment_lock_sha256": {
      "description": "SHA-256 of the uv.lock file",
      "title": "Environment Lock Sha256",
      "type": "string"
    },
    "dataset_ids": {
      "description": "List of dataset IDs used",
      "items": {
        "type": "string"
      },
      "title": "Dataset Ids",
      "type": "array"
    },
    "data_manifest_sha256": {
      "description": "SHA-256 of the data manifest",
      "title": "Data Manifest Sha256",
      "type": "string"
    },
    "split_manifest_sha256": {
      "description": "SHA-256 of the split manifest",
      "title": "Split Manifest Sha256",
      "type": "string"
    },
    "feature_contract_sha256": {
      "description": "SHA-256 of the feature contract",
      "title": "Feature Contract Sha256",
      "type": "string"
    },
    "model_config_sha256": {
      "description": "SHA-256 of the model config",
      "title": "Model Config Sha256",
      "type": "string"
    },
    "random_seeds": {
      "$ref": "#/$defs/RandomSeeds",
      "description": "Seeds used for randomness"
    },
    "command": {
      "description": "The command used to execute the run",
      "items": {
        "type": "string"
      },
      "title": "Command",
      "type": "array"
    },
    "sealed_test_opened": {
      "default": false,
      "description": "Whether sealed test data was opened",
      "title": "Sealed Test Opened",
      "type": "boolean"
    },
    "pooled_training": {
      "description": "Whether data was pooled across datasets",
      "title": "Pooled Training",
      "type": "boolean"
    },
    "registry_state": {
      "$ref": "#/$defs/RegistryStateEnum",
      "description": "Current state of the run in the registry"
    }
  },
  "required": [
    "run_id",
    "created_at_utc",
    "git_commit",
    "environment_lock_sha256",
    "dataset_ids",
    "data_manifest_sha256",
    "split_manifest_sha256",
    "feature_contract_sha256",
    "model_config_sha256",
    "random_seeds",
    "command",
    "pooled_training",
    "registry_state"
  ],
  "title": "RunManifest",
  "type": "object"
}