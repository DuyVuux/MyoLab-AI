{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motionlab.local/schemas/gate-b-readiness.schema.json",
  "title": "Gate B Real Data Readiness Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "gate_id",
    "day",
    "evaluation_mode",
    "criteria",
    "manual_review",
    "decision"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "gate_id": {
      "const": "GATE_B"
    },
    "day": {
      "const": "DAY_20"
    },
    "evaluation_mode": {
      "const": "EVIDENCE_GATED"
    },
    "criteria": {
      "type": "array",
      "minItems": 13,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "category",
          "critical",
          "status",
          "pass_statuses",
          "evidence_refs",
          "why"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^GB-[0-9]{2}$"
          },
          "name": {
            "type": "string",
            "minLength": 5
          },
          "category": {
            "enum": [
              "PRIVACY",
              "SCHEMA",
              "SAFETY",
              "TECHNOLOGY",
              "TRACEABILITY",
              "EVIDENCE"
            ]
          },
          "critical": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "VERIFIED_DOCUMENTED",
              "LIVE_REPO_VERIFIED",
              "SITE_VERIFIED",
              "NOT_VERIFIED",
              "UNKNOWN",
              "TBD",
              "DISCOVERY_REQUIRED",
              "BLOCKED",
              "TEST_FIXTURE_ONLY"
            ]
          },
          "pass_statuses": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "VERIFIED_DOCUMENTED",
                "LIVE_REPO_VERIFIED",
                "SITE_VERIFIED"
              ]
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "why": {
            "type": "string",
            "minLength": 5
          }
        }
      }
    },
    "manual_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewer_id",
        "reviewed_at",
        "evidence_scope_reviewed",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "PENDING",
            "APPROVED",
            "REJECTED"
          ]
        },
        "reviewer_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_scope_reviewed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_decision",
        "day_status",
        "reason"
      ],
      "properties": {
        "gate_decision": {
          "enum": [
            "REAL_DATA_READY",
            "BLOCKED_PRIVACY",
            "BLOCKED_SCHEMA"
          ]
        },
        "day_status": {
          "enum": [
            "GO_FOR_DAY_21",
            "BLOCKED_WITH_EVIDENCE"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
