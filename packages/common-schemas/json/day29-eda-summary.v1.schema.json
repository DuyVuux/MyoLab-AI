{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "day29-eda-summary.v1",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "training_allowed",
    "test_signal_rows_read",
    "fatigue_inference_allowed"
  ],
  "properties": {
    "schema_version": {
      "const": "day29-eda-summary.v1"
    },
    "status": {
      "enum": [
        "NOT_RUN",
        "COMPLETED",
        "COMPLETED_WITH_ERRORS"
      ]
    },
    "training_allowed": {
      "const": false
    },
    "test_signal_rows_read": {
      "const": 0
    },
    "fatigue_inference_allowed": {
      "const": false
    }
  },
  "additionalProperties": true
}
