{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motionlab.local/schemas/uncertainty-handoff.schema.json",
  "title": "Typed Uncertainty Handoff v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "uncertainty_type", "calibration_status", "abstention",
    "abstention_reason", "rule_confidence_level", "calibrated_probability",
    "conformal_set", "calibration_ref"
  ],
  "properties": {
    "uncertainty_type": {"enum": ["RULE_CONFIDENCE", "CALIBRATED_PROBABILITY", "CONFORMAL_SET", "NOT_APPLICABLE"]},
    "calibration_status": {"enum": ["NOT_APPLICABLE", "CALIBRATED", "NOT_VALIDATED"]},
    "abstention": {"type": "boolean"},
    "abstention_reason": {"type": ["string", "null"]},
    "rule_confidence_level": {"type": ["string", "null"], "enum": ["LOW", "MODERATE", "HIGH", "UNKNOWN", null]},
    "calibrated_probability": {"type": ["number", "null"], "minimum": 0.0, "maximum": 1.0},
    "conformal_set": {"type": ["array", "null"], "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "calibration_ref": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"abstention": {"const": true}}, "required": ["abstention"]},
      "then": {"properties": {"abstention_reason": {"type": "string", "minLength": 1}}},
      "else": {"properties": {"abstention_reason": {"type": "null"}}}
    },
    {
      "if": {"properties": {"uncertainty_type": {"const": "NOT_APPLICABLE"}}, "required": ["uncertainty_type"]},
      "then": {"properties": {
        "calibration_status": {"const": "NOT_APPLICABLE"},
        "rule_confidence_level": {"type": "null"},
        "calibrated_probability": {"type": "null"},
        "conformal_set": {"type": "null"},
        "calibration_ref": {"type": "null"}
      }}
    },
    {
      "if": {"properties": {"uncertainty_type": {"const": "RULE_CONFIDENCE"}}, "required": ["uncertainty_type"]},
      "then": {"properties": {
        "calibration_status": {"const": "NOT_APPLICABLE"},
        "rule_confidence_level": {"enum": ["LOW", "MODERATE", "HIGH", "UNKNOWN"]},
        "calibrated_probability": {"type": "null"},
        "conformal_set": {"type": "null"},
        "calibration_ref": {"type": "null"}
      }}
    },
    {
      "if": {"properties": {"uncertainty_type": {"const": "CALIBRATED_PROBABILITY"}}, "required": ["uncertainty_type"]},
      "then": {"properties": {
        "calibration_status": {"const": "CALIBRATED"},
        "calibrated_probability": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "calibration_ref": {"type": "string", "minLength": 1},
        "rule_confidence_level": {"type": "null"},
        "conformal_set": {"type": "null"}
      }}
    },
    {
      "if": {"properties": {"uncertainty_type": {"const": "CONFORMAL_SET"}}, "required": ["uncertainty_type"]},
      "then": {"properties": {
        "calibration_status": {"const": "CALIBRATED"},
        "conformal_set": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "calibration_ref": {"type": "string", "minLength": 1},
        "rule_confidence_level": {"type": "null"},
        "calibrated_probability": {"type": "null"}
      }}
    }
  ]
}
