{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semg-clinical-intelligence.local/schemas/rollback-record.schema.json",
  "title": "sEMG Clinical Intelligence Rollback Record",
  "x-governance": {
    "schema_version": "1.0",
    "status": "PROVISIONAL_LOCKED_FOR_DAY26_BLUEPRINT",
    "rationale": "Defines traceable rollback planning, approval, execution and verification.",
    "evidence_ids": [
      "D26-INT-PROTOCOL",
      "EXT-NIST-AIRMF",
      "EXT-MLFLOW-REGISTRY"
    ],
    "open_questions": [
      "Final site emergency approval roles"
    ],
    "training_allowed": false
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "rationale",
    "evidence_ids",
    "open_questions",
    "training_allowed",
    "record_type",
    "rollback_id",
    "rollback_state",
    "created_at",
    "from_release_id",
    "to_release_id",
    "trigger",
    "impact",
    "actions",
    "verification",
    "approvals",
    "evidence_preserved",
    "audit_log_refs"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "training_allowed": {
      "type": "boolean"
    },
    "record_type": {
      "const": "rollback_record"
    },
    "rollback_id": {
      "type": "string",
      "pattern": "^RBK-[0-9]{8}-[A-Z0-9-]+-[0-9]{3}$"
    },
    "rollback_state": {
      "enum": [
        "planned",
        "approved",
        "executing",
        "completed",
        "failed",
        "drill-not-run"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "from_release_id": {
      "type": "string",
      "minLength": 1
    },
    "to_release_id": {
      "type": "string",
      "minLength": 1
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger_type",
        "detected_at",
        "severity",
        "description"
      ],
      "properties": {
        "trigger_type": {
          "enum": [
            "security",
            "integrity",
            "compatibility",
            "performance",
            "workflow",
            "license",
            "human-request",
            "drill",
            "other"
          ]
        },
        "detected_at": {
          "type": "string",
          "format": "date-time"
        },
        "severity": {
          "enum": [
            "low",
            "moderate",
            "high",
            "critical",
            "not-applicable"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "incident_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "affected_scope",
        "new_processing_frozen",
        "pending_sessions_reviewed"
      ],
      "properties": {
        "affected_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "new_processing_frozen": {
          "type": "boolean"
        },
        "pending_sessions_reviewed": {
          "type": "boolean"
        },
        "known_patient_or_user_impact": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "action",
          "owner_role",
          "status"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "owner_role": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "planned",
              "completed",
              "failed",
              "skipped"
            ]
          },
          "evidence_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_hashes_verified",
        "compatibility_verified",
        "smoke_tests",
        "negative_tests",
        "outcome"
      ],
      "properties": {
        "target_hashes_verified": {
          "type": "boolean"
        },
        "compatibility_verified": {
          "type": "boolean"
        },
        "smoke_tests": {
          "enum": [
            "NOT_RUN",
            "PASS",
            "FAIL"
          ]
        },
        "negative_tests": {
          "enum": [
            "NOT_RUN",
            "PASS",
            "FAIL"
          ]
        },
        "outcome": {
          "enum": [
            "NOT_RUN",
            "SUCCESS",
            "PARTIAL",
            "FAILED"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/review_decision"
      }
    },
    "evidence_preserved": {
      "type": "boolean"
    },
    "audit_log_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "config_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config_id",
        "version",
        "uri",
        "sha256"
      ],
      "properties": {
        "config_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "role",
        "uri",
        "media_type",
        "sha256",
        "size_bytes",
        "trust_class"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "dataset_manifest",
            "raw_registry",
            "split_manifest",
            "test_seal",
            "preprocessing_config",
            "feature_config",
            "model_config",
            "calibration_config",
            "threshold_policy",
            "abstention_policy",
            "environment_lock",
            "model_bundle",
            "model_card",
            "evaluation_report",
            "prediction_ledger",
            "failure_cases",
            "release_manifest",
            "rollback_record",
            "code_archive",
            "hash_ledger",
            "sbom",
            "other"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "trust_class": {
          "enum": [
            "canonical-typed",
            "converted-runtime",
            "trusted-python-snapshot",
            "reference-only"
          ]
        }
      }
    },
    "review_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_role",
        "reviewer_id",
        "decision",
        "decided_at",
        "reasons"
      ],
      "properties": {
        "reviewer_role": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_id": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": [
            "pending",
            "approved",
            "approved-with-conditions",
            "rejected"
          ]
        },
        "decided_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "license_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "license_id",
        "access_class",
        "training_use",
        "research_use",
        "commercial_use",
        "redistribution",
        "trained_artifact_distribution",
        "attribution_required",
        "dua_or_irb_required",
        "review_status"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "license_id": {
          "type": "string",
          "minLength": 1
        },
        "license_uri_or_dua_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "access_class": {
          "enum": [
            "open",
            "registration",
            "dua",
            "restricted",
            "internal",
            "not-verified"
          ]
        },
        "training_use": {
          "enum": [
            "allowed",
            "not-allowed",
            "not-verified",
            "not-applicable"
          ]
        },
        "research_use": {
          "enum": [
            "allowed",
            "not-allowed",
            "not-verified",
            "not-applicable"
          ]
        },
        "commercial_use": {
          "enum": [
            "allowed",
            "not-allowed",
            "not-verified",
            "not-applicable"
          ]
        },
        "redistribution": {
          "enum": [
            "allowed",
            "not-allowed",
            "not-verified",
            "not-applicable"
          ]
        },
        "trained_artifact_distribution": {
          "enum": [
            "allowed",
            "not-allowed",
            "not-verified",
            "not-applicable"
          ]
        },
        "attribution_required": {
          "type": "boolean"
        },
        "share_alike_required": {
          "type": "boolean",
          "default": false
        },
        "dua_or_irb_required": {
          "type": "boolean"
        },
        "review_status": {
          "enum": [
            "reviewed",
            "pending",
            "not-verified"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "license_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregate_decision",
        "sources",
        "blocking_reasons"
      ],
      "properties": {
        "aggregate_decision": {
          "enum": [
            "pass-research",
            "pass-internal-engineering",
            "pass-pilot-noncommercial",
            "pass-pilot-approved",
            "block",
            "not-verified"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/license_source"
          }
        },
        "blocking_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
