{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myolab-ai.local/schemas/research-dataset-manifest.v0.2.schema.json",
  "title": "Research Dataset Manifest v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "datasetId", "canonicalName", "version", "taskAlignment", "source", "access", "population", "hierarchy", "signal", "labels", "privacy", "readiness"],
  "properties": {
    "schemaVersion": {"const": "research-dataset-manifest.v0.2"},
    "datasetId": {"type": "string", "minLength": 1},
    "canonicalName": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "taskAlignment": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["TaskA", "TaskB", "TaskC"]}
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalUrl", "doi", "sourceStatus", "retrievedAt", "sourceHashSha256"],
      "properties": {
        "canonicalUrl": {"type": ["string", "null"]},
        "doi": {"type": ["string", "null"]},
        "sourceStatus": {"enum": ["OFFICIAL_VERIFIED", "PEER_REVIEWED_VERIFIED", "REPOSITORY_VERIFIED", "INFERRED", "CONFLICTING", "NOT_VERIFIED"]},
        "retrievedAt": {"type": ["string", "null"], "format": "date-time"},
        "sourceHashSha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accessClass", "licenseClass", "licenseText", "commercialUseAllowed", "redistributionAllowed", "duaRequired"],
      "properties": {
        "accessClass": {"enum": ["FREE_OPEN_NO_REGISTRATION", "FREE_WITH_REGISTRATION", "FREE_WITH_DUA_OR_APPLICATION", "ACADEMIC_ONLY_ACCESS", "RESTRICTED_OR_IRB_CONTROLLED", "PAID_FIXED_PRICE", "PAID_QUOTE_REQUIRED", "PUBLIC_DOWNLOAD_REPORTED", "ACCESS_CONFLICTING", "ACCESS_UNKNOWN"]},
        "licenseClass": {"enum": ["COMMERCIAL_USE_PERMITTED", "RESEARCH_ONLY", "NONCOMMERCIAL_ONLY", "REDISTRIBUTION_PROHIBITED", "DERIVATIVES_RESTRICTED", "CUSTOM_AGREEMENT_REQUIRED", "LICENSE_NOT_FOUND", "LICENSE_AMBIGUOUS"]},
        "licenseText": {"type": ["string", "null"]},
        "commercialUseAllowed": {"type": "boolean"},
        "redistributionAllowed": {"type": "boolean"},
        "duaRequired": {"type": "boolean"}
      }
    },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cohort", "subjectCount", "pathology"],
      "properties": {
        "cohort": {"type": "string"},
        "subjectCount": {"type": ["integer", "null"], "minimum": 1},
        "pathology": {"type": ["string", "null"]}
      }
    },
    "hierarchy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subjectIdAvailable", "sessionIdAvailable", "trialIdAvailable", "repetitionIdAvailable", "splitUnit"],
      "properties": {
        "subjectIdAvailable": {"type": "boolean"},
        "sessionIdAvailable": {"type": "boolean"},
        "trialIdAvailable": {"type": "boolean"},
        "repetitionIdAvailable": {"type": "boolean"},
        "splitUnit": {"enum": ["subject", "session"]}
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rawAvailable", "samplingRateHz", "unit", "channelCount", "electrodeGeometry"],
      "properties": {
        "rawAvailable": {"type": "boolean"},
        "samplingRateHz": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "unit": {"type": ["string", "null"]},
        "channelCount": {"type": ["integer", "null"], "minimum": 1},
        "electrodeGeometry": {"type": ["string", "null"]}
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taxonomyVersion", "classes", "labelTimingProvenance"],
      "properties": {
        "taxonomyVersion": {"type": "string"},
        "classes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "labelTimingProvenance": {"type": "string"}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["containsDirectIdentifiers", "rawSamplesEmbeddedInManifest"],
      "properties": {
        "containsDirectIdentifiers": {"const": false},
        "rawSamplesEmbeddedInManifest": {"const": false}
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "trainingAllowed", "blockingItems"],
      "properties": {
        "status": {"enum": ["go", "conditional", "no_go"]},
        "trainingAllowed": {"type": "boolean"},
        "blockingItems": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
