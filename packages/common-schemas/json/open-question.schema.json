{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motionlab.vsf.local/schemas/open-question.schema.json",
  "title": "MotionLab Open Question Register v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "day",
    "questions"
  ],
  "properties": {
    "version": {
      "const": "0.1"
    },
    "day": {
      "const": "DAY01"
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_id",
          "question",
          "source",
          "why_it_matters",
          "evidence_needed",
          "owner",
          "target_day",
          "blocking_scope",
          "fallback",
          "status",
          "evidence_status"
        ],
        "properties": {
          "question_id": {
            "type": "string",
            "pattern": "^OQ-\\d{3}$"
          },
          "question": {
            "type": "string",
            "minLength": 5
          },
          "source": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "why_it_matters": {
            "type": "string",
            "minLength": 5
          },
          "evidence_needed": {
            "type": "string",
            "minLength": 5
          },
          "owner": {
            "type": "string",
            "minLength": 2
          },
          "target_day": {
            "type": "string",
            "pattern": "^DAY_\\d{2}$"
          },
          "blocking_scope": {
            "type": "string",
            "minLength": 2
          },
          "fallback": {
            "type": "string",
            "minLength": 5
          },
          "status": {
            "enum": [
              "OPEN",
              "ANSWERED",
              "DEFERRED",
              "BLOCKED"
            ]
          },
          "evidence_status": {
            "enum": [
              "VERIFIED_DOCUMENTED",
              "OBSERVED_SAMPLE_DATA",
              "SITE_VERIFIED",
              "INFERRED",
              "ASSUMPTION",
              "UNKNOWN",
              "TBD",
              "NOT_VERIFIED",
              "DISCOVERY_REQUIRED",
              "CONFLICTING"
            ]
          }
        }
      }
    }
  }
}
