{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "remote-catalog.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "created_at",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "remote-catalog.v1"
    },
    "created_at": {
      "type": "string"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "record_id",
          "url",
          "official_source",
          "format",
          "partition"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "official_source": {
            "type": "boolean"
          },
          "format": {
            "type": "string"
          },
          "partition": {
            "type": "string"
          },
          "size_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "accept_ranges": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "head_status": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}