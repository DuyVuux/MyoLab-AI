{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semg-fatigue.local/schemas/spectral-window-row.schema.json",
  "title": "Spectral Window Row v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "spectral_row_id",
    "session_id",
    "channel",
    "phase_id",
    "profile_id",
    "window",
    "status",
    "spectral",
    "reason_codes",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "spectral-window-row.v0.1"
    },
    "spectral_row_id": {
      "type": "string",
      "pattern": "^SR-[0-9a-f]{24}$"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_id",
        "muscle",
        "side",
        "role"
      ],
      "properties": {
        "channel_id": {
          "type": "string",
          "minLength": 1
        },
        "muscle": {
          "type": "string",
          "minLength": 1
        },
        "side": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "phase_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_id": {
      "const": "frequency_domain"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_id",
        "window_index",
        "start_sample",
        "end_sample_exclusive",
        "start_time_s",
        "end_time_exclusive_s",
        "center_time_s",
        "sample_count"
      ],
      "properties": {
        "window_id": {
          "type": "string",
          "pattern": "^W[0-9]{4,}$"
        },
        "window_index": {
          "type": "integer",
          "minimum": 0
        },
        "start_sample": {
          "type": "integer",
          "minimum": 0
        },
        "end_sample_exclusive": {
          "type": "integer",
          "minimum": 1
        },
        "start_time_s": {
          "type": "number",
          "minimum": 0
        },
        "end_time_exclusive_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "center_time_s": {
          "type": "number",
          "minimum": 0
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "status": {
      "enum": [
        "computed",
        "not_computed"
      ]
    },
    "spectral": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "psd",
            "band_power",
            "full_power",
            "time_domain_variance",
            "window_weighted_power",
            "parseval_ratio",
            "qa_flags",
            "peak_frequency"
          ],
          "properties": {
            "psd": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "values",
                "unit"
              ],
              "properties": {
                "values": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "unit": {
                  "const": "uV^2/Hz"
                }
              }
            },
            "band_power": {
              "$ref": "#/$defs/powerValue"
            },
            "full_power": {
              "$ref": "#/$defs/powerValue"
            },
            "time_domain_variance": {
              "$ref": "#/$defs/powerValue"
            },
            "parseval_ratio": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "qa_flags": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "peak_frequency": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "unit",
                "purpose"
              ],
              "properties": {
                "value": {
                  "oneOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "unit": {
                  "const": "Hz"
                },
                "purpose": {
                  "const": "qa_only_not_fatigue_feature"
                }
              }
            },
            "window_weighted_power": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "unit"
              ],
              "properties": {
                "value": {
                  "type": "number",
                  "minimum": 0
                },
                "unit": {
                  "const": "uV^2"
                }
              }
            }
          }
        }
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spectral_estimator_id",
        "windowing_config_id",
        "preprocess_config_id",
        "source_signal_hash_sha256",
        "window_plan_hash_sha256"
      ],
      "properties": {
        "spectral_estimator_id": {
          "const": "spectral_estimation_v0.1"
        },
        "windowing_config_id": {
          "const": "windowing_v0.1"
        },
        "preprocess_config_id": {
          "const": "preprocess_v0.1"
        },
        "source_signal_hash_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "window_plan_hash_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "computed"
          }
        }
      },
      "then": {
        "properties": {
          "spectral": {
            "type": "object"
          },
          "reason_codes": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "not_computed"
          }
        }
      },
      "then": {
        "properties": {
          "spectral": {
            "type": "null"
          },
          "reason_codes": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "powerValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "const": "uV^2"
        }
      }
    }
  }
}
