{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "day29-readiness-decision.v1",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "training_allowed",
    "test_set_opened"
  ],
  "properties": {
    "schema_version": {
      "const": "day29-readiness-decision.v1"
    },
    "status": {
      "enum": [
        "GO_FOR_DAY30_HARMONIZATION",
        "BLOCKED_WITH_EVIDENCE",
        "PENDING_MANUAL_GATE_REVIEW"
      ]
    },
    "training_allowed": {
      "const": false
    },
    "test_set_opened": {
      "const": false
    },
    "motionlab_transfer_verified": {
      "type": "boolean"
    },
    "clinical_use_allowed": {
      "type": "boolean"
    },
    "missing_or_failed_checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
