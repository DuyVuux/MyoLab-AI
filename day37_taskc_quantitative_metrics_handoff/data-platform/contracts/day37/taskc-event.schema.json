{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task C Metric Event",
  "type": "object",
  "required": [
    "metric_family",
    "metric_id",
    "supportability",
    "reason_codes",
    "provenance",
    "hard_fatigue_diagnosis_allowed"
  ],
  "properties": {
    "metric_family": {
      "enum": [
        "repeatability",
        "similarity",
        "cocontraction"
      ]
    },
    "metric_id": {
      "type": "string"
    },
    "value": {
      "type": [
        "number",
        "null"
      ]
    },
    "supportability": {
      "type": "string"
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object"
    },
    "hard_fatigue_diagnosis_allowed": {
      "const": false
    }
  }
}