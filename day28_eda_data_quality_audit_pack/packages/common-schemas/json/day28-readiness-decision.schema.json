{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "day28-readiness-decision.schema.json",
  "title": "Day 28 Readiness Decision",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "training_execution_allowed",
    "motion_lab_transfer_verified",
    "clinical_use_allowed"
  ],
  "properties": {
    "schema_version": {
      "const": "day28-readiness-decision.v1"
    },
    "status": {
      "enum": [
        "GO_FOR_DAY29_TRAINING_PREFLIGHT",
        "BLOCKED_WITH_EVIDENCE"
      ]
    },
    "training_execution_allowed": {
      "const": false
    },
    "motion_lab_transfer_verified": {
      "const": false
    },
    "clinical_use_allowed": {
      "const": false
    },
    "test_set_sealed": {
      "const": true
    },
    "supported_class_count": {
      "const": 4
    },
    "hand_open_supported": {
      "const": false
    }
  },
  "additionalProperties": true
}
