{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semg-fatigue.local/schemas/frequency-feature-row.schema.json",
  "title": "Frequency Feature Row v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "frequency_feature_row_id",
    "session_id",
    "channel",
    "phase_id",
    "profile_id",
    "window",
    "status",
    "features",
    "reason_codes",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "frequency-feature-row.v0.1"
    },
    "frequency_feature_row_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "type": "object"
    },
    "phase_id": {
      "type": "string"
    },
    "profile_id": {
      "const": "frequency_domain"
    },
    "window": {
      "type": "object"
    },
    "status": {
      "enum": [
        "computed",
        "not_computed"
      ]
    },
    "features": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object"
        }
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object"
    }
  }
}
