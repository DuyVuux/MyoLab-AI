{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semg-fatigue.local/schemas/frequency-feature-verification.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "frequency_axis",
    "checks",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "frequency-feature-verification.v0.1"
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "frequency_axis": {
      "type": "object"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
